    {
      "parameters": {
        "jsCode": "// Получаем сохранённый текст из первого Code-узла\n// ВАЖНО: замени 'Prepare Input' на реальное имя твоего первого Code-узла!\nconst savedChatText = $('check').first().json.originalChatText || \"\";\n\n// Получаем текст из документа (ответ парсера)\nconst docText = $json.raw_text || \"\";\n\n// Склеиваем\nlet finalPrompt = \"\";\nif (docText) {\n    finalPrompt = `Содержимое документа:\\n${docText}\\n\\n`;\n}\nif (savedChatText) {\n    finalPrompt += `Комментарий пользователя: ${savedChatText}`;\n}\n\nreturn {\n    json: {\n        final_prompt: finalPrompt,\n        raw_text: docText,\n        chat_input: savedChatText\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        -128
      ],
      "id": "067eebfc-906d-4c81-a939-d1bbbe9751d0",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "// Code node: \"Prepare Input\"\nconst chatText = $json.chatInput || \"\";\nconst hasFile = $json.files && $json.files.length > 0;\n\nif (hasFile) {\n  // Если есть файл, возвращаем данные для парсера + сохраняем текст чата\n  return [{\n    json: {\n      ...$json,\n      originalChatText: chatText, // сохраняем текст пользователя\n      needsParsing: true\n    },\n    binary: $input.item.binary // обязательно пробрасываем файл дальше [citation:6]\n  }];\n} else {\n  // Если файла нет, сразу возвращаем текст для агента\n  return [{\n    json: {\n      ...$json,\n      raw_text: chatText,\n      needsParsing: false\n    }\n  }];\n}"
      },
